TMDB_API_KEY=
TARATRACK_PASSWORD=
TARATRACK_SECRET_KEY=
# Opcional - usuario de la primera cuenta (admin), creada al primer arranque a partir
# de TARATRACK_PASSWORD. Por defecto "principal" si no se pone.
TARATRACK_ADMIN_USERNAME=
# Opcional en local (por defecto /data/taratrack.db, pensado para el volumen de
# Docker) - fuera de Docker pon una ruta escribible, p. ej. ./taratrack.db
TARATRACK_DB_PATH=./taratrack.db
